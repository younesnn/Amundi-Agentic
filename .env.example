# Copier ce fichier en .env (ignoré par Git) et remplir les valeurs localement.
# Ne jamais commiter .env. Aucune API payante : voir DECISIONS.md (D-004).

# Moteur principal : Google AI Studio, niveau gratuit de l'API Gemini
GEMINI_API_KEY=
# Relais quand le quota Gemini est atteint : Groq, niveau gratuit
GROQ_API_KEY=
# Développement et tests : Ollama en local
OLLAMA_API_BASE=http://localhost:11434

# Données (phase 2)
# FRED : clé gratuite sur https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# SEC EDGAR exige un User-Agent identifiant le demandeur (nom + adresse e-mail)
SEC_EDGAR_USER_AGENT=

# Emplacements du stockage local (optionnels ; défauts indiqués)
# AMUNDI_DATA_DIR : dossier qui CONTIENT store/ (Parquet), snapshots/ et http/ (défaut : .cache/data).
#   Ne pas confondre avec AMUNDI_DATA_STORE, qui désigne store/ lui-même et ne sert qu'aux tests de
#   revue en lecture seule (aucun code ne la lit).
# AMUNDI_DATA_DIR=.cache/data
# AMUNDI_RAG_DIR : index du RAG sur les 10-K et 10-Q (défaut : .cache/rag).
# AMUNDI_RAG_DIR=.cache/rag
